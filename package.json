{
  "name": "algoalive",
  "private": true,
  "version": "0.1.0",
  "description": "Bring your LeetCode algorithms to life — step-by-step Python visualizer powered by Pyodide + sys.settrace",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "npm run test:tracer && npm run test:js && npm run test:e2e",
    "test:tracer": "node scripts/python.mjs scripts/check_examples.py",
    "test:js": "node scripts/check_js.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "acorn": "^8.19.0",
    "framer-motion": "^14.3.1",
    "lucide-react": "^1.59.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
